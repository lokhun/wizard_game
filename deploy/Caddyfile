# Serves the built game (dist/, mounted at /srv) on 127.0.0.1:3003.
# The rift Caddy in front handles HTTPS for play.lokhunproject.fun.
{
	admin off
	auto_https off
	persist_config off
}

:3003 {
	bind 127.0.0.1
	# Other deploy scripts on this Droplet check https://play.lokhunproject.fun/healthz.
	respond /healthz "ok" 200
	# co-op: matchmaking (PeerJS, WebSocket) and the relay's short-lived logins (signal/server.mjs)
	@net path /net-config /peerjs/*
	reverse_proxy @net 127.0.0.1:3004

	# Hashed assets never change; index.html always revalidates (same rules as public/_headers).
	@assets path /assets/*
	@pages not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @pages Cache-Control "no-cache"

	root * /srv
	file_server {
		precompressed br gzip
		hide .htaccess _headers
	}
}
